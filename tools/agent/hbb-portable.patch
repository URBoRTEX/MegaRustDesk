 const PEERS: &str = "peers";
 
+/// Decode storage protection without loading CONFIG or recursively acquiring KEY_PAIR.
+/// The return value requests persistence after a reset or legacy plaintext migration.
+#[cfg(windows)]
+fn agent_unlock_identity(config: &mut Config) -> bool {
+    if std::env::var_os("RUSTDESK_AGENT_DATA").is_none() { return false; }
+    if !config.key_pair.0.starts_with(b"RDAP1") { return !config.key_pair.0.is_empty(); }
+    match agent_protect_key(&config.key_pair.0[5..], false) {
+        Ok(key) if key.len() == sign::SECRETKEYBYTES && config.key_pair.1.len() == sign::PUBLICKEYBYTES => {
+            config.key_pair.0 = key;
+            false
+        }
+        _ => {
+            config.key_pair = Default::default();
+            config.password.clear();
+            config.key_confirmed = false;
+            config.keys_confirmed.clear();
+            std::env::set_var("RUSTDESK_AGENT_SECRET_RESET", "1");
+            true
+        }
+    }
+}
+
+#[cfg(windows)]
+fn agent_protect_key(bytes: &[u8], protect: bool) -> std::io::Result<Vec<u8>> {
+    use winapi::um::dpapi::{CryptProtectData, CryptUnprotectData, CRYPTPROTECT_UI_FORBIDDEN};
+    use winapi::um::wincrypt::CRYPT_INTEGER_BLOB;
+    let mut input = CRYPT_INTEGER_BLOB { cbData: bytes.len() as u32, pbData: bytes.as_ptr() as *mut u8 };
+    let mut output: CRYPT_INTEGER_BLOB = unsafe { std::mem::zeroed() };
+    let ok = unsafe {
+        if protect { CryptProtectData(&mut input, std::ptr::null(), std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut(), CRYPTPROTECT_UI_FORBIDDEN, &mut output) }
+        else { CryptUnprotectData(&mut input, std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut(), CRYPTPROTECT_UI_FORBIDDEN, &mut output) }
+    };
+    if ok == 0 { return Err(std::io::Error::last_os_error()); }
+    let result = unsafe { std::slice::from_raw_parts(output.pbData, output.cbData as usize).to_vec() };
+    unsafe { winapi::um::winbase::LocalFree(output.pbData as _); }
+    Ok(result)
+}
