+#[cfg(all(test, windows))]
+mod agent_key_tests {
+    #[test]
+    fn reloaded_portable_identity_can_sign() {
+        use super::*;
+        let root = std::env::temp_dir().join(format!("rustdesk-agent-key-test-{}", uuid::Uuid::new_v4()));
+        assert!(!root.exists());
+        let previous_data = std::env::var_os("RUSTDESK_AGENT_DATA");
+        std::env::set_var("RUSTDESK_AGENT_DATA", &root);
+        let (public, secret) = sign::gen_keypair();
+        let mut config = Config::default();
+        config.key_pair = (secret.0.to_vec(), public.0.to_vec());
+        config.store();
+        let on_disk = Config::load_::<Config>("");
+        assert!(on_disk.key_pair.0.starts_with(b"RDAP1"));
+        *KEY_PAIR.lock().unwrap() = None;
+        let reloaded = Config::get_key_pair();
+        let valid_length = reloaded.0.len() == sign::SECRETKEYBYTES;
+        let valid_signature = valid_length && {
+            let mut key = [0; sign::SECRETKEYBYTES];
+            key.copy_from_slice(&reloaded.0);
+            let message = b"synthetic-portable-restart-check";
+            sign::verify(&sign::sign(message, &sign::SecretKey(key)), &public)
+                .map_or(false, |decoded| decoded == message)
+        };
+        let previous_reset = std::env::var_os("RUSTDESK_AGENT_SECRET_RESET");
+        let mut corrupted = Config::default();
+        corrupted.key_pair = (b"RDAP1invalid-synthetic-blob".to_vec(), public.0.to_vec());
+        corrupted.password = "synthetic-test-password".into();
+        corrupted.key_confirmed = true;
+        corrupted.keys_confirmed.insert("synthetic-server".into(), true);
+        assert!(agent_unlock_identity(&mut corrupted));
+        assert!(corrupted.key_pair.0.is_empty() && corrupted.key_pair.1.is_empty());
+        assert!(corrupted.password.is_empty() && !corrupted.key_confirmed && corrupted.keys_confirmed.is_empty());
+        assert_eq!(std::env::var("RUSTDESK_AGENT_SECRET_RESET").unwrap(), "1");
+        match previous_reset {
+            Some(value) => std::env::set_var("RUSTDESK_AGENT_SECRET_RESET", value),
+            None => std::env::remove_var("RUSTDESK_AGENT_SECRET_RESET"),
+        }
+        // Remove only the exact synthetic file created above, then empty directories.
+        let file = Config::file_("");
+        assert!(file.starts_with(&root));
+        std::fs::remove_file(file).unwrap();
+        for folder in [root.join("rustdesk/config"), root.join("rustdesk"), root.clone()] {
+            std::fs::remove_dir(folder).unwrap();
+        }
+        *KEY_PAIR.lock().unwrap() = None;
+        match previous_data {
+            Some(value) => std::env::set_var("RUSTDESK_AGENT_DATA", value),
+            None => std::env::remove_var("RUSTDESK_AGENT_DATA"),
+        }
+        assert!(valid_length, "Reloaded signing key must be 64 bytes, not the protected storage blob");
+        assert!(valid_signature, "Reloaded portable identity must retain its signing capability");
+    }
+
+    #[test]
+    fn identity_key_is_protected_for_current_windows_user() {
+        let synthetic = b"synthetic-key-for-portable-dpapi-test";
+        let encrypted = super::agent_protect_key(synthetic, true).unwrap();
+        assert_ne!(encrypted, synthetic);
+        assert_eq!(super::agent_protect_key(&encrypted, false).unwrap(), synthetic);
+        assert!(super::agent_protect_key(b"corrupted protected key", false).is_err());
+    }
+}
